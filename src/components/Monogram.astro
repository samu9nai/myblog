---
interface Props {
  class?: string
}

// m의 두 아치를 커밋 그래프처럼 그리고 양 끝에 커밋 점을 찍었다. 색은 currentColor를 따른다.
const { class: className } = Astro.props
---

<svg
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="5.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}>
  <path d="M13 48V31a9.5 9.5 0 0 1 19 0v17M32 31a9.5 9.5 0 0 1 19 0v17"></path>
  <circle
    cx="13"
    cy="48"
    r="1"
    stroke-width="9"></circle>
  <circle
    cx="51"
    cy="48"
    r="1"
    stroke-width="9"></circle>
</svg>
