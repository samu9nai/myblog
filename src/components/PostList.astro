---
import type { CollectionEntry } from 'astro:content'
import Badge from '@/components/ui/Badge.astro'
import Row from '@/components/ui/Row.astro'
import { formatDate } from '@/utils/posts'

interface Props {
  posts: CollectionEntry<'posts'>[]
  // 목록이 h2 섹션 안에 들어가면 h3로 낮춘다.
  heading?: 'h2' | 'h3'
}

const { posts, heading: Heading = 'h2' } = Astro.props
---

<ul class="border-border mt-6 border-t">
  {posts.map(post => (
    <Row
      href={`/posts/${post.id}/`}
      class="py-4">
      <span class="min-w-0">
        <Heading class="group-hover:text-accent font-medium transition-colors">
          {post.data.title}
          {post.data.draft && <Badge>draft</Badge>}
        </Heading>
        <p class="text-muted mt-1 text-sm">{post.data.description}</p>
      </span>
      <time
        slot="meta"
        datetime={post.data.pubDate.toISOString()}
        class="meta">
        {formatDate(post.data.pubDate)}
      </time>
    </Row>
  ))}
</ul>
