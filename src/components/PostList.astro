---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@/utils/posts'

interface Props {
  posts: CollectionEntry<'posts'>[]
  // 목록이 h2 섹션 안에 들어가면 h3로 낮춘다.
  heading?: 'h2' | 'h3'
}

const { posts, heading: Heading = 'h2' } = Astro.props
---

<ul class="border-border mt-6 border-t">
  {posts.map(post => (
    <li class="border-border border-b">
      <a
        href={`/posts/${post.id}/`}
        class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
        <span class="min-w-0">
          <Heading class="group-hover:text-accent font-medium transition-colors">
            {post.data.title}
            {post.data.draft && (
              <span class="text-muted ml-2 font-mono text-xs font-normal">
                draft
              </span>
            )}
          </Heading>
          <p class="text-muted mt-1 text-sm">{post.data.description}</p>
        </span>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="text-muted shrink-0 font-mono text-xs">
          {formatDate(post.data.pubDate)}
        </time>
      </a>
    </li>
  ))}
</ul>
