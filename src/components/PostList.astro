---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@/utils/posts'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<ul class="mt-8 flex flex-col gap-8">
  {posts.map(post => (
    <li>
      <a
        href={`/posts/${post.id}/`}
        class="group block">
        <h2 class="group-hover:text-accent text-lg font-semibold transition-colors">
          {post.data.title}
          {post.data.draft && (
            <span class="text-muted ml-2 font-mono text-xs">draft</span>
          )}
        </h2>
        <p class="text-muted mt-1">{post.data.description}</p>
      </a>
      <time
        datetime={post.data.pubDate.toISOString()}
        class="text-muted mt-2 block font-mono text-sm">
        {formatDate(post.data.pubDate)}
      </time>
    </li>
  ))}
</ul>
