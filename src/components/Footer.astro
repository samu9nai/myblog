---
import { site } from '@/site'
import { buildCommit } from '@/utils/build'
import { getResume } from '@/utils/resume'

const { profile } = await getResume()
---

<footer class="border-border text-muted flex items-end justify-between border-t py-6 text-sm print:hidden">
  <div class="flex flex-col gap-1">
    <span>
      © {new Date().getFullYear()} {site.name}
    </span>
    {buildCommit && (
      <a
        href={`${site.repo}/commit/${buildCommit.sha}`}
        class="hover:text-fg font-mono text-xs transition-colors">
        build {buildCommit.short} · {buildCommit.date}
      </a>
    )}
  </div>
  <div class="flex gap-4">
    <a
      href={`mailto:${profile.email}`}
      class="hover:text-fg transition-colors">
      메일
    </a>
    <a
      href={site.github}
      class="hover:text-fg transition-colors">
      GitHub
    </a>
  </div>
</footer>
