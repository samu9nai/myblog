---
import type { CollectionEntry } from 'astro:content'
import { formatPeriod } from '@/utils/projects'

type Item = CollectionEntry<'resume'>['data']['projects'][number]

interface Props {
  item: Item
}

const { item } = Astro.props
const facts = [
  ['소속', item.context],
  ['역할', item.role],
  ['기여', item.contribution],
  ['기술', item.stack.join(', ')]
].filter((fact): fact is [string, string] => Boolean(fact[1]))
---

<article class="mt-8 first:mt-6">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 break-after-avoid">
    <h3 class="text-base font-bold">
      {item.project ? (
        <a
          href={`/projects/${item.project.id}/`}
          class="hover:text-accent underline-offset-4 transition-colors hover:underline">
          {item.name}
        </a>
      ) : (
        item.name
      )}
    </h3>
    <p class="text-muted font-mono text-sm">{formatPeriod(item.period)}</p>
  </div>
  <p class="text-muted mt-1">{item.summary}</p>
  <dl class="mt-3 grid grid-cols-[3rem_1fr] gap-x-3 gap-y-1 text-sm">
    {facts.map(([label, value]) => (
      <>
        <dt class="text-muted">{label}</dt>
        <dd>{value}</dd>
      </>
    ))}
  </dl>
  {item.work.map(work => (
    <section class="mt-5 break-inside-avoid">
      <h4 class="font-bold">
        {work.title}
        {work.refs && (
          <span class="text-muted ml-2 font-mono text-xs font-normal">
            {work.refs}
          </span>
        )}
      </h4>
      <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm leading-relaxed">
        {work.points.map(point => (
          <li>{point}</li>
        ))}
      </ul>
    </section>
  ))}
</article>
