---
import { getEntry, type CollectionEntry } from 'astro:content'
import { formatPeriod } from '@/utils/projects'

type Item = CollectionEntry<'resume'>['data']['projects'][number]

interface Props {
  item: Item
}

const { item } = Astro.props
const facts = [
  ['소속', item.context],
  ['역할', item.role],
  ['기여', item.contribution],
  ['기술', item.stack.join(', ')]
].filter((fact): fact is [string, string] => Boolean(fact[1]))
const work = await Promise.all(
  item.work.map(async line => ({
    ...line,
    case: line.case && (await getEntry(line.case))
  }))
)
---

<article class="mt-8 first:mt-6">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 break-after-avoid">
    <h3 class="text-base font-bold">
      {item.project ? (
        <a
          href={`/projects/${item.project.id}/`}
          class="hover:text-accent underline-offset-4 press-fade hover:underline">
          {item.name}
        </a>
      ) : (
        item.name
      )}
    </h3>
    <p class="text-muted font-mono text-sm">{formatPeriod(item.period)}</p>
  </div>
  <p class="text-muted mt-1">{item.summary}</p>
  <dl class="mt-3 grid grid-cols-[3rem_1fr] gap-x-3 gap-y-1 text-sm">
    {facts.map(([label, value]) => (
      <>
        <dt class="text-muted">{label}</dt>
        <dd>{value}</dd>
      </>
    ))}
  </dl>
  <ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
    {work.map(line => (
      <li class="break-inside-avoid">
        {line.text}
        {line.refs && (
          <span class="text-muted ml-2 font-mono text-xs whitespace-nowrap">
            {line.refs}
          </span>
        )}
        {line.case && (
          <a
            href={`/posts/${line.case.id}/`}
            aria-label={`사례 글: ${line.case.data.title}`}
            class="text-muted hover:text-accent ml-2 font-mono text-xs whitespace-nowrap underline underline-offset-4 press-fade">
            사례
          </a>
        )}
      </li>
    ))}
  </ul>
</article>
