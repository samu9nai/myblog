---
import Search from '@/components/Search.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { nav, site } from '@/site'

const path = Astro.url.pathname
const isCurrent = (href: string) => path.startsWith(href)
---

<header class="border-border flex items-center justify-between border-b py-5 print:hidden">
  <a
    href="/"
    class="press-fade font-mono font-semibold">
    {site.name}
  </a>
  <nav
    aria-label="주 메뉴"
    class="flex items-center gap-5 text-sm">
    {nav.map(item => (
      <a
        href={item.href}
        aria-current={isCurrent(item.href) ? 'page' : undefined}
        class="text-muted hover:text-fg aria-[current=page]:text-fg press-fade">
        {item.label}
      </a>
    ))}
    <Search />
    <ThemeToggle />
  </nav>
</header>
