<button
  type="button"
  id="theme-toggle"
  aria-label="다크 모드로 전환"
  class="text-muted hover:text-fg hover:bg-surface press -m-2 rounded-lg p-2">
  <svg
    class="size-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg
    class="hidden size-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true">
    <circle
      cx="12"
      cy="12"
      r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const root = document.documentElement
  const button = document.getElementById('theme-toggle')

  const label = () => {
    button?.setAttribute(
      'aria-label',
      root.dataset.theme === 'dark' ? '라이트 모드로 전환' : '다크 모드로 전환'
    )
  }

  label()
  const apply = (next: string) => {
    root.dataset.theme = next
    try {
      localStorage.setItem('theme', next)
    } catch {
      // 저장소를 쓸 수 없어도 이번 페이지에서는 전환한다.
    }
    label()
  }

  // 버튼 가운데에서 원이 퍼지며 새 테마가 화면을 덮는다. View Transitions를 못 쓰면 바로 바꾼다.
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
    if (!document.startViewTransition) {
      apply(next)
      return
    }
    const transition = document.startViewTransition(() => apply(next))
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const { left, top, width, height } = button.getBoundingClientRect()
    const x = left + width / 2
    const y = top + height / 2
    const radius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y)
    )
    void transition.ready.then(() => {
      root.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${radius}px at ${x}px ${y}px)`
          ]
        },
        {
          duration: 450,
          easing: 'cubic-bezier(0.77, 0, 0.175, 1)',
          pseudoElement: '::view-transition-new(root)'
        }
      )
    })
  })
</script>
