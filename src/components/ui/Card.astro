---
interface Props {
  // 주면 카드 전체가 링크가 되어 hover·누름 피드백을 받는다.
  href?: string
  class?: string
}

const { href, class: className } = Astro.props
---

{href ? (
  <a
    href={href}
    class:list={[
      'group bg-surface press-soft block rounded-2xl p-5 hover:bg-[color-mix(in_oklab,var(--color-surface),var(--color-fg)_4%)]',
      className
    ]}>
    <slot />
  </a>
) : (
  <div class:list={['bg-surface rounded-2xl p-5', className]}>
    <slot />
  </div>
)}
