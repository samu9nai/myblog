---
import '@/styles/global.css'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { site } from '@/site'
import regularBasic from '@/assets/fonts/hakgyoansim-dunggeunmiso/HakgyoansimDunggeunmiso-R-basic.woff2?url'
import regularKs from '@/assets/fonts/hakgyoansim-dunggeunmiso/HakgyoansimDunggeunmiso-R-ks.woff2?url'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  ogType?: 'website' | 'article'
}

const {
  title,
  description = site.description,
  ogImage = '/og.png',
  ogType = 'website'
} = Astro.props
const pageTitle = title ? `${title} · ${site.name}` : site.name
const pageUrl = new URL(Astro.url.pathname, Astro.site)
const ogImageUrl = new URL(ogImage, Astro.site)
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content={description}
    />
    <meta
      property="og:type"
      content={ogType}
    />
    <meta
      property="og:site_name"
      content={site.name}
    />
    <meta
      property="og:locale"
      content="ko_KR"
    />
    <meta
      property="og:title"
      content={title ?? site.name}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:url"
      content={pageUrl}
    />
    <meta
      property="og:image"
      content={ogImageUrl}
    />
    <meta
      property="og:image:width"
      content="1200"
    />
    <meta
      property="og:image:height"
      content="630"
    />
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    {/* 본문 글꼴은 CSS를 다 읽은 뒤에야 요청되므로, 거의 모든 페이지에 쓰이는 Regular 두 조각을 미리 받는다. */}
    {[regularBasic, regularKs].map(href => (
      <link
        rel="preload"
        href={href}
        as="font"
        type="font/woff2"
        crossorigin
      />
    ))}
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <link
      rel="sitemap"
      href="/sitemap-index.xml"
    />
    <script is:inline>
      // 첫 페인트 전에 테마를 정해 깜빡임을 막는다. 저장된 선택이 없으면 다크(큐어 아르카나 섀도)로 시작한다.
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('theme')
        } catch {}
        document.documentElement.dataset.theme =
          stored === 'light' ? 'light' : 'dark'
      })()
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-fg text-bg sr-only rounded px-3 py-2 focus:not-sr-only focus:fixed focus:top-4 focus:left-4">
      본문으로 건너뛰기
    </a>
    <div class="mx-auto flex w-full max-w-2xl flex-1 flex-col px-4">
      <Header />
      <main
        id="main"
        class="flex-1 py-12 print:py-0">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
