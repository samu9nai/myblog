---
import Layout from '@/layouts/Layout.astro'
import Emphasis from '@/components/Emphasis.astro'
import Monogram from '@/components/Monogram.astro'
import Button from '@/components/ui/Button.astro'
import Card from '@/components/ui/Card.astro'
import Row from '@/components/ui/Row.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import StackChips from '@/components/ui/StackChips.astro'
import { formatDate, getCases, getPosts } from '@/utils/posts'
import { formatKind, formatPeriod, getProjects } from '@/utils/projects'
import { getResume } from '@/utils/resume'

const resume = await getResume()
const { profile, highlights } = resume
const [featured, ...projects] = (await getProjects()).slice(0, 3)
const featuredCases = featured ? (await getCases(featured.id)).length : 0
const posts = (await getPosts()).slice(0, 3)

// 프로젝트는 위 projects가 보여 주므로, 교육과 과정만 시작한 달 기준 최신순으로 늘어놓는다.
const timeline = resume.education
  .map(item => ({ start: item.start, title: item.school, detail: item.degree }))
  .sort((a, b) => b.start.localeCompare(a.start))

const month = (value: string) => value.replace('-', '.')
---

<Layout>
  <section>
    <div class="flex items-center gap-4">
      <span class="bg-surface border-border text-mark grid size-14 shrink-0 place-items-center rounded-2xl border">
        <Monogram class="size-10" />
      </span>
      <div>
        <h1 class="text-xl font-bold">{profile.name}</h1>
        <p class="text-muted text-sm">{profile.title}</p>
      </div>
    </div>
    <p class="text-muted mt-6 leading-relaxed">
      <Emphasis text={profile.summary} />
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <Button href="/resume/">이력서</Button>
      <a
        href={`mailto:${profile.email}`}
        class="hover:text-accent text-sm transition-colors">
        메일 보내기
      </a>
    </div>
  </section>

  {highlights.length > 0 && (
    <section class="mt-16">
      <SectionHeader label="highlights" />
      <ul class="mt-3">
        {highlights.map(highlight =>
          highlight.link ? (
            <Row
              href={highlight.link}
              class="py-3 text-sm">
              <span class="group-hover:text-accent transition-colors">
                {highlight.short ?? highlight.text}
              </span>
              <span
                slot="meta"
                class="meta group-hover:text-accent transition-colors">
                {highlight.source ?? '근거'}
                <span
                  aria-hidden="true"
                  class="nudge-ne ml-1">
                  ↗
                </span>
              </span>
            </Row>
          ) : (
            <Row class="py-3 text-sm">
              <span>{highlight.short ?? highlight.text}</span>
              {highlight.source && (
                <span
                  slot="meta"
                  class="meta">
                  {highlight.source}
                </span>
              )}
            </Row>
          )
        )}
      </ul>
    </section>
  )}

  {featured && (
    <section class="mt-16">
      <SectionHeader
        label="projects"
        href="/projects/"
        more="프로젝트 전체 보기"
      />
      <Card
        href={`/projects/${featured.id}/`}
        class="mt-3">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="group-hover:text-accent font-medium transition-colors">
            {featured.data.name}
          </h3>
          <span class="meta">{formatPeriod(featured.data.period)}</span>
        </div>
        <p class="text-muted mt-1 text-sm leading-relaxed">
          {featured.data.summary}
        </p>
        <p class="text-muted mt-3 font-mono text-xs">
          {formatKind(featured.data)}
          {featuredCases > 0 && ` · 사례 ${featuredCases}개`}
        </p>
        <StackChips
          stack={featured.data.stack}
          limit={4}
          class="mt-3"
        />
      </Card>
      <ul class="mt-2">
        {projects.map(project => (
          <Row
            href={`/projects/${project.id}/`}
            class="py-3">
            <span class="min-w-0">
              <span class="group-hover:text-accent block font-medium transition-colors">
                {project.data.name}
              </span>
              <span class="text-muted mt-0.5 block text-sm sm:truncate">
                {project.data.summary}
              </span>
            </span>
            <span
              slot="meta"
              class="meta">
              {formatPeriod(project.data.period)}
            </span>
          </Row>
        ))}
      </ul>
    </section>
  )}

  {timeline.length > 0 && (
    <section class="mt-16">
      <SectionHeader label="timeline" />
      <ol class="border-border mt-4 ml-1 border-l">
        {timeline.map(item => (
          <li class="relative pb-4 pl-5 last:pb-0">
            <span class="star absolute top-[5px] -left-[5.5px]" />
            <p class="flex gap-4 text-sm">
              <span class="text-muted w-14 shrink-0 font-mono text-xs leading-5">
                {month(item.start)}
              </span>
              <span>
                {item.title}
                {item.detail && (
                  <span class="text-muted ml-2">{item.detail}</span>
                )}
              </span>
            </p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {posts.length > 0 && (
    <section class="mt-16">
      <SectionHeader
        label="writing"
        href="/posts/"
        more="글 전체 보기"
      />
      <ul class="mt-3">
        {posts.map(post => (
          <Row
            href={`/posts/${post.id}/`}
            layout="inline"
            class="py-3 text-sm">
            <span class="group-hover:text-accent transition-colors">
              {post.data.title}
            </span>
            <time
              slot="meta"
              datetime={post.data.pubDate.toISOString()}
              class="meta">
              {formatDate(post.data.pubDate)}
            </time>
          </Row>
        ))}
      </ul>
    </section>
  )}
</Layout>
