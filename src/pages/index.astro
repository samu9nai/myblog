---
import Layout from '@/layouts/Layout.astro'
import Emphasis from '@/components/Emphasis.astro'
import Monogram from '@/components/Monogram.astro'
import { formatDate, getCases, getPosts } from '@/utils/posts'
import { formatKind, formatPeriod, getProjects } from '@/utils/projects'
import { getResume } from '@/utils/resume'

const resume = await getResume()
const { profile, highlights } = resume
const [featured, ...projects] = (await getProjects()).slice(0, 3)
const featuredCases = featured ? (await getCases(featured.id)).length : 0
const posts = (await getPosts()).slice(0, 3)

// 프로젝트는 위 projects가 보여 주므로, 교육과 과정만 시작한 달 기준 최신순으로 늘어놓는다.
const timeline = resume.education
  .map(item => ({ start: item.start, title: item.school, detail: item.degree }))
  .sort((a, b) => b.start.localeCompare(a.start))

const month = (value: string) => value.replace('-', '.')
---

<Layout>
  <section>
    <div class="flex items-center gap-4">
      <span class="bg-surface border-border text-mark grid size-14 shrink-0 place-items-center rounded-2xl border">
        <Monogram class="size-10" />
      </span>
      <div>
        <h1 class="text-xl font-bold">{profile.name}</h1>
        <p class="text-muted text-sm">{profile.title}</p>
      </div>
    </div>
    <p class="text-muted mt-6 leading-relaxed">
      <Emphasis text={profile.summary} />
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a
        href="/resume/"
        class="bg-fg text-bg press rounded-lg px-3.5 py-1.5 text-sm font-medium hover:opacity-85">
        이력서
      </a>
      <a
        href={`mailto:${profile.email}`}
        class="hover:text-accent text-sm transition-colors">
        메일 보내기
      </a>
    </div>
  </section>

  {highlights.length > 0 && (
    <section class="mt-16">
      <h2 class="section-label">highlights</h2>
      <ul class="mt-3">
        {highlights.map(highlight => (
          <li class="border-border border-b">
            {highlight.link ? (
              <a
                href={highlight.link}
                class="group flex flex-col gap-1 py-3 text-sm sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <span class="group-hover:text-accent transition-colors">
                  {highlight.short ?? highlight.text}
                </span>
                <span class="text-muted group-hover:text-accent shrink-0 font-mono text-xs transition-colors">
                  {highlight.source ?? '근거'}
                  <span
                    aria-hidden="true"
                    class="nudge-ne ml-1">
                    ↗
                  </span>
                </span>
              </a>
            ) : (
              <div class="flex flex-col gap-1 py-3 text-sm sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <span>{highlight.short ?? highlight.text}</span>
                {highlight.source && (
                  <span class="text-muted shrink-0 font-mono text-xs">
                    {highlight.source}
                  </span>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {featured && (
    <section class="mt-16">
      <div class="flex items-baseline justify-between">
        <h2 class="section-label">projects</h2>
        <a
          href="/projects/"
          class="text-muted hover:text-accent text-xs transition-colors">
          프로젝트 전체 보기
        </a>
      </div>
      <a
        href={`/projects/${featured.id}/`}
        class="group bg-surface press-soft mt-3 block rounded-2xl p-5 hover:bg-[color-mix(in_oklab,var(--color-surface),var(--color-fg)_4%)]">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="group-hover:text-accent font-medium transition-colors">
            {featured.data.name}
          </h3>
          <span class="text-muted shrink-0 font-mono text-xs">
            {formatPeriod(featured.data.period)}
          </span>
        </div>
        <p class="text-muted mt-1 text-sm leading-relaxed">
          {featured.data.summary}
        </p>
        <p class="text-muted mt-3 font-mono text-xs">
          {formatKind(featured.data)}
          {featuredCases > 0 && ` · 사례 ${featuredCases}개`}
        </p>
        <ul
          aria-label="기술 스택"
          class="mt-3 flex flex-wrap gap-1.5">
          {featured.data.stack.slice(0, 4).map(item => (
            <li class="chip">{item}</li>
          ))}
        </ul>
      </a>
      <ul class="mt-2">
        {projects.map(project => (
          <li class="border-border border-b">
            <a
              href={`/projects/${project.id}/`}
              class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <span class="min-w-0">
                <span class="group-hover:text-accent block font-medium transition-colors">
                  {project.data.name}
                </span>
                <span class="text-muted mt-0.5 block text-sm sm:truncate">
                  {project.data.summary}
                </span>
              </span>
              <span class="text-muted shrink-0 font-mono text-xs">
                {formatPeriod(project.data.period)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {timeline.length > 0 && (
    <section class="mt-16">
      <h2 class="section-label">timeline</h2>
      <ol class="border-border mt-4 ml-1 border-l">
        {timeline.map(item => (
          <li class="relative pb-4 pl-5 last:pb-0">
            <span class="star absolute top-[5px] -left-[5.5px]" />
            <p class="flex gap-4 text-sm">
              <span class="text-muted w-14 shrink-0 font-mono text-xs leading-5">
                {month(item.start)}
              </span>
              <span>
                {item.title}
                {item.detail && (
                  <span class="text-muted ml-2">{item.detail}</span>
                )}
              </span>
            </p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {posts.length > 0 && (
    <section class="mt-16">
      <div class="flex items-baseline justify-between">
        <h2 class="section-label">writing</h2>
        <a
          href="/posts/"
          class="text-muted hover:text-accent text-xs transition-colors">
          글 전체 보기
        </a>
      </div>
      <ul class="mt-3">
        {posts.map(post => (
          <li class="border-border border-b">
            <a
              href={`/posts/${post.id}/`}
              class="group flex items-baseline justify-between gap-4 py-3 text-sm">
              <span class="group-hover:text-accent transition-colors">
                {post.data.title}
              </span>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-muted shrink-0 font-mono text-xs">
                {formatDate(post.data.pubDate)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
