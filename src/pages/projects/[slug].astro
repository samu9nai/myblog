---
import { getEntry, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/PostList.astro'
import Card from '@/components/ui/Card.astro'
import SectionHeader from '@/components/ui/SectionHeader.astro'
import StackChips from '@/components/ui/StackChips.astro'
import { ogImagePath } from '@/utils/og'
import { getCases } from '@/utils/posts'
import { formatKind, formatPeriod, getProjects } from '@/utils/projects'
import { splitRefs } from '@/utils/refs'

export async function getStaticPaths() {
  const projects = await getProjects()
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project }
  }))
}

const { project } = Astro.props
const { data } = project
const { Content } = await render(project)
const cases = await getCases(project.id)
const basedOn = data.basedOn && (await getEntry(data.basedOn))

// 칩은 앞쪽 대표 기술만 보이고, 나머지는 한 줄 텍스트로 붙인다.
const chipLimit = 8

const linkLabels = { repo: '저장소', docs: '문서', live: '서비스' } as const
const links = (Object.keys(linkLabels) as (keyof typeof linkLabels)[])
  .filter(key => data.links[key])
  .map(key => ({ label: linkLabels[key], href: data.links[key]! }))
---

<Layout
  title={data.name}
  description={data.summary}
  ogImage={ogImagePath(`/og/projects/${project.id}.png`, {
    title: data.name,
    description: data.summary
  })}>
  <article>
    <header class="border-border border-b pb-6">
      <h1 class="text-xl font-bold">{data.name}</h1>
      <p class="text-muted mt-2">{data.summary}</p>
      <dl class="mt-6 grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-2 text-sm sm:grid-cols-[5rem_1fr]">
        <dt class="text-muted">기간</dt>
        <dd class="font-mono">{formatPeriod(data.period)}</dd>
        <dt class="text-muted">형태</dt>
        <dd>{formatKind(data)}</dd>
        <dt class="text-muted">기술</dt>
        <dd>
          <StackChips
            stack={data.stack}
            limit={chipLimit}
          />
          {data.stack.length > chipLimit && (
            <p class="text-muted mt-2 font-mono text-xs">
              {data.stack.slice(chipLimit).join(', ')}
            </p>
          )}
        </dd>
        {basedOn && (
          <>
            <dt class="text-muted">원본</dt>
            <dd>
              <a
                href={`/projects/${basedOn.id}/`}
                class="text-accent underline underline-offset-4">
                {basedOn.data.name}
              </a>
            </dd>
          </>
        )}
        {links.length > 0 && (
          <>
            <dt class="text-muted">링크</dt>
            <dd class="flex flex-wrap gap-x-4">
              {links.map(link => (
                <a
                  href={link.href}
                  class="text-accent underline underline-offset-4">
                  {link.label}
                </a>
              ))}
            </dd>
          </>
        )}
      </dl>
    </header>

    <section class="mt-10">
      <SectionHeader label="overview" />
      <div class="prose mt-4">
        <Content />
      </div>
    </section>

    {data.kind === 'team' && (
      <section class="mt-12">
        <SectionHeader label="boundary" />
        <Card class="mt-4">
          <h3 class="font-bold">내가 한 일</h3>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
            {data.boundary.mine
              .map(item => splitRefs(item, data.links.repo))
              .map(({ text, refs }) => (
                <li>
                  {text}
                  {refs.map(ref =>
                    ref.url ? (
                      <a
                        href={ref.url}
                        class="text-muted hover:text-accent ml-1.5 font-mono text-xs whitespace-nowrap underline-offset-4 transition-colors hover:underline">
                        {ref.label}
                      </a>
                    ) : (
                      <span class="text-muted ml-1.5 font-mono text-xs whitespace-nowrap">
                        {ref.label}
                      </span>
                    )
                  )}
                </li>
              ))}
          </ul>
        </Card>
        <div class="mt-6 px-5">
          <h3 class="text-muted font-bold">팀이 한 일</h3>
          <ul class="text-muted mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed">
            {data.boundary.team.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {cases.length > 0 && (
      <section class="mt-12">
        <SectionHeader label="cases" />
        <PostList
          posts={cases}
          heading="h3"
        />
      </section>
    )}
  </article>
</Layout>
