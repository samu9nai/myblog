---
import Layout from '@/layouts/Layout.astro'
import { formatKind, formatPeriod, getProjects } from '@/utils/projects'

const projects = await getProjects()

// 목록에는 앞쪽 스택만 보이고 나머지는 상세 페이지에서 본다.
const stackLimit = 6
---

<Layout
  title="프로젝트"
  description="참여한 팀 프로젝트와 개인 프로젝트">
  <h1 class="text-xl font-bold">프로젝트</h1>
  <p class="text-muted mt-1 text-sm">참여한 팀 프로젝트와 개인 프로젝트</p>
  {projects.length === 0 ? (
    <p class="text-muted mt-6">아직 공개한 프로젝트가 없습니다.</p>
  ) : (
    <ul class="border-border mt-6 border-t">
      {projects.map(project => (
        <li class="border-border border-b">
          <a
            href={`/projects/${project.id}/`}
            class="group block py-5">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="group-hover:text-accent font-medium transition-colors">
                {project.data.name}
                {project.data.draft && (
                  <span class="text-muted ml-2 font-mono text-xs font-normal">
                    draft
                  </span>
                )}
              </h2>
              <span class="text-muted shrink-0 font-mono text-xs">
                {formatPeriod(project.data.period)}
              </span>
            </div>
            <p class="text-muted mt-1 text-sm leading-relaxed">
              {project.data.summary}
            </p>
            <p class="text-muted mt-2 line-clamp-1 text-sm">
              <span class="font-mono text-xs">{formatKind(project.data)}</span>
              <span class="mx-2">·</span>
              {project.data.role.join(', ')}
            </p>
            <ul
              aria-label="기술 스택"
              class="mt-3 flex flex-wrap gap-1.5">
              {project.data.stack.slice(0, stackLimit).map(item => (
                <li class="chip">{item}</li>
              ))}
              {project.data.stack.length > stackLimit && (
                <li class="text-muted px-1 font-mono text-[11px]">
                  +{project.data.stack.length - stackLimit}
                </li>
              )}
            </ul>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>
