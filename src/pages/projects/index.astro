---
import Layout from '@/layouts/Layout.astro'
import { formatKind, formatPeriod, getProjects } from '@/utils/projects'

const projects = await getProjects()
---

<Layout
  title="프로젝트"
  description="참여한 팀 프로젝트와 개인 프로젝트">
  <h1 class="text-2xl font-bold">프로젝트</h1>
  {projects.length === 0 ? (
    <p class="text-muted mt-6">아직 공개한 프로젝트가 없습니다.</p>
  ) : (
    <ul class="mt-8 flex flex-col gap-6">
      {projects.map(project => (
        <li>
          <a
            href={`/projects/${project.id}/`}
            class="group border-border hover:border-muted block rounded-lg border p-5 transition-colors">
            <h2 class="group-hover:text-accent text-lg font-semibold transition-colors">
              {project.data.name}
              {project.data.draft && (
                <span class="text-muted ml-2 font-mono text-xs">draft</span>
              )}
            </h2>
            <p class="text-muted mt-1">{project.data.summary}</p>
            <p class="text-muted mt-3 font-mono text-sm">
              {formatPeriod(project.data.period)} · {formatKind(project.data)}
            </p>
            <p class="mt-2 text-sm">
              <span class="text-muted">역할</span>{' '}
              {project.data.role.join(', ')}
            </p>
            <ul
              aria-label="기술 스택"
              class="mt-3 flex flex-wrap gap-1.5">
              {project.data.stack.map(item => (
                <li class="bg-surface rounded px-2 py-0.5 font-mono text-xs">
                  {item}
                </li>
              ))}
            </ul>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>
