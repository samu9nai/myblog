---
import Layout from '@/layouts/Layout.astro'
import { formatDate, getPosts } from '@/utils/posts'

const posts = await getPosts()
---

<Layout
  title="글"
  description="설계 결정과 문제 해결 과정을 기록한 글">
  <h1 class="text-2xl font-bold">글</h1>
  {posts.length === 0 ? (
    <p class="text-muted mt-6">아직 발행한 글이 없습니다.</p>
  ) : (
    <ul class="mt-8 flex flex-col gap-8">
      {posts.map(post => (
        <li>
          <a
            href={`/posts/${post.id}`}
            class="group block">
            <h2 class="group-hover:text-accent text-lg font-semibold transition-colors">
              {post.data.title}
              {post.data.draft && (
                <span class="text-muted ml-2 font-mono text-xs">draft</span>
              )}
            </h2>
            <p class="text-muted mt-1">{post.data.description}</p>
          </a>
          <time
            datetime={post.data.pubDate.toISOString()}
            class="text-muted mt-2 block font-mono text-sm">
            {formatDate(post.data.pubDate)}
          </time>
        </li>
      ))}
    </ul>
  )}
</Layout>
