---
import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/PostList.astro'
import { getPosts } from '@/utils/posts'

const posts = await getPosts()
---

<Layout
  title="글"
  description="설계 결정과 문제 해결 과정을 기록한 글">
  <h1 class="text-xl font-bold">글</h1>
  <p class="text-muted mt-1 text-sm">설계 결정과 문제 해결 과정을 기록한 글</p>
  {posts.length === 0 ? (
    <p class="text-muted mt-6">아직 발행한 글이 없습니다.</p>
  ) : (
    <PostList posts={posts} />
  )}
</Layout>
