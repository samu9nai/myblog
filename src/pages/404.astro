---
import Layout from '@/layouts/Layout.astro'
---

<Layout title="페이지를 찾을 수 없음">
  <p class="text-muted font-mono text-sm">404</p>
  <h1 class="mt-2 text-2xl font-bold">페이지를 찾을 수 없습니다</h1>
  <p class="text-muted mt-3">
    주소가 바뀌었거나 아직 만들지 않은 페이지입니다.
  </p>
  <a
    href="/"
    class="text-accent mt-6 inline-block underline underline-offset-4">
    홈으로 가기
  </a>
</Layout>
