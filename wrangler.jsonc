{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  // workerd 1.20261001이 지원하는 가장 최근 날짜다.
  "compatibility_date": "2026-10-01",
  // 서버 코드 없이 Astro 정적 빌드 결과만 배포한다.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // 프로덕션이 아닌 브랜치는 Workers Builds가 `wrangler preview`로 배포한다.
  // 이 명령은 previews 블록이 있어야 동작하고, 비어 있으면 위의 설정을 그대로 쓴다.
  "previews": {},
  // 미리보기마다 https://<브랜치>-blog.samu9nai.workers.dev 주소를 만든다.
  // Worker 단위 설정이라 프로덕션 브랜치의 wrangler deploy로 반영된다.
  "preview_urls": true
}
