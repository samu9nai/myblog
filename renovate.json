{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    ":timezone(Asia/Seoul)"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "packageRules": [
    {
      "description": "minor·patch 업데이트는 한 PR로 묶는다",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates",
      "groupSlug": "minor-patch"
    },
    {
      "description": "major 업데이트는 Dependency Dashboard에서 승인한 것만 PR을 연다",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "astro check는 TypeScript 7을 지원하지 않는다. TS 7.1과 @astrojs/ts-content-mapper가 정식으로 나오면 올린다",
      "matchDepNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
